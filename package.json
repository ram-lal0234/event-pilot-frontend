{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test -c e2e/playwright.config.ts --ui",
    "test:e2e:mobile": "playwright test -c e2e/playwright.config.ts --project=mobile-safari --project=mobile-chrome",
    "test:e2e:debug": "playwright test -c e2e/playwright.config.ts --debug",
    "test:e2e:report": "playwright show-report",
    "test:mobile-smoke": "playwright test -c e2e/playwright.config.ts e2e/smoke/mobile-touch-targets.spec.ts --project=mobile-chrome"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
